# Copy this file to .env.local and fill in the values.
# (Backend/API env vars live in server/.env.example — this file is the
#  Next.js storefront only.)

# ────────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION
# ────────────────────────────────────────────────────────────────────

# Origin of the deployed Express API. Next rewrites /api/:path* to it so the
# browser stays same-origin and auth cookies remain first-party.
# The production build FAILS if neither this nor NEXT_PUBLIC_API_URL is set —
# without it every login/order/catalog call 404s at runtime.
# Also used server-side by app/sitemap.ts and app/products/[id]/page.tsx.
# Locally you can leave it empty: the app talks to http://localhost:4000 direct.
BACKEND_URL=

# ────────────────────────────────────────────────────────────────────
# OPTIONAL
# ────────────────────────────────────────────────────────────────────

# Escape hatch to call the API cross-origin instead of via the /api proxy.
# Leave unset for the normal same-origin proxy setup.
# NEXT_PUBLIC_API_URL=

# Google Sign-In. Without it the "Continue with Google" button is not rendered
# at all (see components/GoogleSignInButton.tsx). Must be the SAME client id as
# the backend's GOOGLE_OAUTH_CLIENT_ID, and this app's origin must be listed in
# the OAuth client's "Authorized JavaScript origins".
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Google Gemini API key (free tier) — powers the on-site chat assistant.
# If unset, /api/chat returns 503 and the widget shows a friendly notice.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to a built-in fallback chain).
# GEMINI_MODEL=gemini-2.0-flash

# Optional: shared secret that unlocks GET /api/chat's diagnostic probe.
# Without it the probe reports configuration only and never calls Gemini.
# CHAT_DIAGNOSTIC_TOKEN=
