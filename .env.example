# Copy this file to .env.local and fill in the values.

# Google Gemini API key (free tier) — powers the on-site chat assistant.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash
