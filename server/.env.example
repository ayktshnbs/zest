# ────────────────────────────────────────────────────────────────────
# Zest Home backend — copy to .env and fill in. Never commit .env.
# ────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# CORS — the URL(s) your Next.js frontend runs on. Comma-separated.
ALLOWED_ORIGINS=http://localhost:3000

# Cookies
COOKIE_DOMAIN=
# When true, cookies are marked Secure. Force to true in production.
COOKIE_SECURE=false

# Database — Postgres connection string OR individual fields. URL wins if set.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zest_kitchene
# Optional individual overrides used when DATABASE_URL is empty
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=zest_kitchene
PG_SSL=false

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CSRF
CSRF_SECRET=replace-me-with-another-random-string

# Bcrypt
BCRYPT_ROUNDS=12

# Frontend URLs (used in emails and OAuth redirects)
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/sifre-sifirla
LOGIN_URL=http://localhost:3000/giris
# Optional — defaults to {FRONTEND_URL}/e-posta-dogrula if unset
EMAIL_VERIFICATION_URL=http://localhost:3000/e-posta-dogrula

# Resend — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Zest Home <no-reply@yourdomain.com>"
EMAIL_REPLY_TO=destek@yourdomain.com

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Use a Web Application client. The "Authorized JavaScript origins" must
# include FRONTEND_URL. Audience is the Web client's client ID.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Creem — https://creem.io (or your gateway's equivalent)
CREEM_API_KEY=creem_sk_xxxxxxxxxxxxxxxxxxxxxxxx
CREEM_API_BASE=https://api.creem.io
CREEM_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
CREEM_SUCCESS_URL=http://localhost:3000/odeme/basarili
CREEM_CANCEL_URL=http://localhost:3000/odeme

# Cloudinary (image upload) — optional; uploads return 503 if unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
